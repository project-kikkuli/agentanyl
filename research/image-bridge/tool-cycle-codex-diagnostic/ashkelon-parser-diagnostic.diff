+            return;
+        };
+        let item = value.get("item");
+        let output_types: Vec<&str> = value
+            .get("response")
+            .and_then(|r| r.get("output"))
+            .and_then(Value::as_array)
+            .map(|items| {
+                items
+                    .iter()
+                    .filter_map(|item| item.get("type").and_then(Value::as_str))
+                    .collect()
+            })
+            .unwrap_or_default();
+        let replay_index = value.get("output_index").and_then(Value::as_u64).unwrap_or(0) as usize;
+        let mut replay_event = serde_json::json!({"type": ty});
+        if let Some(item) = item {
+            replay_event["item"] = Self::diagnostic_item(item, replay_index);
+        }
+        if let Some(response) = value.get("response") {
+            let mut safe_response = serde_json::json!({});
+            if let Some(status) = response.get("status").and_then(Value::as_str) {
+                safe_response["status"] = serde_json::json!(status);
+            }
+            if response.get("id").is_some() {
+                safe_response["id"] = serde_json::json!("diagnostic-response");
+            }
+            if response.get("model").is_some() {
+                safe_response["model"] = serde_json::json!("diagnostic-model");
+            }
+            if let Some(items) = response.get("output").and_then(Value::as_array) {
+                safe_response["output"] = serde_json::Value::Array(
+                    items
+                        .iter()
+                        .enumerate()
+                        .map(|(index, item)| Self::diagnostic_item(item, index))
+                        .collect(),
+                );
+            }
+            replay_event["response"] = safe_response;
+        }
+        let row = serde_json::json!({
