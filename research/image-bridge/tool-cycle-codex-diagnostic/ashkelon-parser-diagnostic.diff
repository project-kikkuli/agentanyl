+    /// Opt-in structural diagnostics for reproducing streaming event parsing.
+    /// Deliberately records no response text, arguments, IDs, prompts, or headers.
+    fn record_event_shape(&self, event_type: Option<&str>, ty: &str, value: &Value) {
